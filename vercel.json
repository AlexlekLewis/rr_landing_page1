{
    "functions": {
        "api/fetch-playhq-stats.js": {
            "maxDuration": 60,
            "memory": 1024
        }
    },
    "headers": [
        {
            "source": "/assets/(.*).mp4",
            "headers": [
                { "key": "Content-Type", "value": "video/mp4" },
                { "key": "Accept-Ranges", "value": "bytes" },
                { "key": "Cache-Control", "value": "public, max-age=31536000" }
            ]
        }
    ],
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/api/$1"
        },
        {
            "source": "/RRACRMDashboard/(.*)",
            "destination": "/RRACRMDashboard/$1"
        },
        {
            "source": "/RRACRMDashboard",
            "destination": "/RRACRMDashboard/index.html"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}
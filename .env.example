# Copy to .env for local development and fill in real values.
# .env is gitignored and must NEVER be committed.
# Production values are set in the Vercel dashboard (Project -> Settings -> Environment Variables).
# Anything VITE_-prefixed is inlined into the public JS bundle — never put a secret in a VITE_ variable.

# --- Supabase (public by design: these ship in the browser bundle) ---
# Required: `vite build` stops if either is missing (see vite.config.js).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- PostHog analytics (public by design; analytics is off when the key is blank) ---
VITE_PUBLIC_POSTHOG_KEY=
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Optional browser settings ---
# Cloudflare Turnstile site key (public by design). When blank, forms use only the honeypot.
VITE_TURNSTILE_SITE_KEY=

# --- Zapier catch hooks: REMOVED ---
# VITE_APP_WEBHOOK_URL, VITE_RSVP_WEBHOOK_URL and VITE_LP3_WEBHOOK_URL used to live here.
# Any hook URL that was ever committed to this repo is treated as public and has to be
# regenerated in Zapier. No routed page uses these variables any more.

# --- Server-side secrets (api/ functions) ---
# These live in Vercel only, never with a VITE_ prefix. For local API work run
#   vercel env pull .env.local
# (.env.local is gitignored). SUPABASE_WEBHOOK_SECRET must equal the Supabase Vault secret
# `supabase_webhook_secret` (see supabase/migrations/20260927120000_sheet_sync_secrets_to_vault.sql).
